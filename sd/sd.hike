func nativeCString(value string) cstring {
    if value == "" { return nil }
    return cstring(value)
}

func nativeContextParams(p *ContextParams) NativeContextParams {
    n := NativeContextParams{}
    sd_ctx_params_init(&n)
    if p == nil { return n }
    n.ModelPath = nativeCString(p.ModelPath); n.ClipLPath = nativeCString(p.ClipLPath)
    n.ClipGPath = nativeCString(p.ClipGPath); n.ClipVisionPath = nativeCString(p.ClipVisionPath)
    n.T5XXLPath = nativeCString(p.T5XXLPath); n.LLMPath = nativeCString(p.LLMPath)
    n.LLMVisionPath = nativeCString(p.LLMVisionPath); n.DiffusionModelPath = nativeCString(p.DiffusionModelPath)
    n.HighNoiseDiffusionModelPath = nativeCString(p.HighNoiseDiffusionModelPath)
    n.UncondDiffusionModelPath = nativeCString(p.UncondDiffusionModelPath)
    n.EmbeddingsConnectorsPath = nativeCString(p.EmbeddingsConnectorsPath)
    n.VAEPath = nativeCString(p.VAEPath); n.AudioVAEPath = nativeCString(p.AudioVAEPath)
    n.AudioEncoderPath = nativeCString(p.AudioEncoderPath); n.TAESDPath = nativeCString(p.TAESDPath)
    n.ControlNetPath = nativeCString(p.ControlNetPath); n.IPAdapterPath = nativeCString(p.IPAdapterPath)
    n.MotionModulePath = nativeCString(p.MotionModulePath)
    var embedding NativeEmbedding
    if p.Embeddings != nil {
        embedding.Name = nativeCString(p.Embeddings.Name); embedding.Path = nativeCString(p.Embeddings.Path)
        n.Embeddings = &embedding
    }
    n.EmbeddingCount = p.EmbeddingCount; n.PhotoMakerPath = nativeCString(p.PhotoMakerPath)
    n.PuLIDWeightsPath = nativeCString(p.PuLIDWeightsPath); n.TensorTypeRules = nativeCString(p.TensorTypeRules)
    n.NThreads = int32(p.NThreads); n.WType = int32(p.WType); n.RNGType = int32(p.RNGType); n.SamplerRNGType = int32(p.SamplerRNGType)
    n.Prediction = int32(p.Prediction); n.LoRAApplyMode = int32(p.LoRAApplyMode); n.EnableMMap = p.EnableMMap
    n.FlashAttn = p.FlashAttn; n.DiffusionFlashAttn = p.DiffusionFlashAttn; n.TAEPreviewOnly = p.TAEPreviewOnly
    n.DiffusionConvDirect = p.DiffusionConvDirect; n.VAEConvDirect = p.VAEConvDirect
    n.ForceSDXLVAEConvScale = p.ForceSDXLVAEConvScale; n.VAEFormat = int32(p.VAEFormat)
    n.MaxVRAM = nativeCString(p.MaxVRAM); n.DisablePrefetch = p.DisablePrefetch; n.EagerLoad = p.EagerLoad
    n.Backend = nativeCString(p.Backend); n.ParamsBackend = nativeCString(p.ParamsBackend)
    n.SplitMode = nativeCString(p.SplitMode); n.AutoFit = p.AutoFit; n.RPCServers = nativeCString(p.RPCServers)
    n.ModelArgs = nativeCString(p.ModelArgs); n.DisableSegmentedCompute = p.DisableSegmentedCompute
    n.LinearScale = p.LinearScale; n.AttnScale = p.AttnScale; n.Tokenizer = nativeCString(p.Tokenizer)
    n.SageAttn = p.SageAttn; n.ConditioningCacheSize = int32(p.ConditioningCacheSize)
    return n
}

func nativeSampleParams(p SampleParams) NativeSampleParams {
    n := NativeSampleParams{}
    n.Guidance.TxtCFG = p.Guidance.TxtCFG; n.Guidance.ImgCFG = p.Guidance.ImgCFG
    n.Guidance.DistilledGuidance = p.Guidance.DistilledGuidance
    n.Guidance.SLG.Layers = p.Guidance.SLG.Layers; n.Guidance.SLG.LayerCount = p.Guidance.SLG.LayerCount
    n.Guidance.SLG.LayerStart = p.Guidance.SLG.LayerStart; n.Guidance.SLG.LayerEnd = p.Guidance.SLG.LayerEnd
    n.Guidance.SLG.Scale = p.Guidance.SLG.Scale; n.Scheduler = int32(p.Scheduler); n.SampleMethod = int32(p.SampleMethod)
    n.SampleSteps = int32(p.SampleSteps); n.Eta = p.Eta; n.ShiftedTimestep = int32(p.ShiftedTimestep)
    n.CustomSigmas = p.CustomSigmas; n.CustomSigmasCount = int32(p.CustomSigmasCount); n.FlowShift = p.FlowShift
    n.ExtraSampleArgs = nativeCString(p.ExtraSampleArgs)
    return n
}

func nativeCacheParams(p CacheParams) NativeCacheParams {
    return NativeCacheParams{Mode:int32(p.Mode), ReuseThreshold:p.ReuseThreshold, StartPercent:p.StartPercent,
        EndPercent:p.EndPercent, ErrorDecayRate:p.ErrorDecayRate, UseRelativeThreshold:p.UseRelativeThreshold,
        ResetErrorOnCompute:p.ResetErrorOnCompute, FnComputeBlocks:p.FnComputeBlocks, BnComputeBlocks:p.BnComputeBlocks,
        ResidualDiffThreshold:p.ResidualDiffThreshold, MaxWarmupSteps:int32(p.MaxWarmupSteps), MaxCachedSteps:int32(p.MaxCachedSteps),
        MaxContinuousCachedSteps:int32(p.MaxContinuousCachedSteps), TaylorseerNDerivatives:int32(p.TaylorseerNDerivatives),
        TaylorseerSkipInterval:int32(p.TaylorseerSkipInterval), SCMMask:nativeCString(p.SCMMask), SCMPolicyDynamic:p.SCMPolicyDynamic,
        SpectrumW:p.SpectrumW, SpectrumM:int32(p.SpectrumM), SpectrumLam:p.SpectrumLam, SpectrumWindowSize:int32(p.SpectrumWindowSize),
        SpectrumFlexWindow:p.SpectrumFlexWindow, SpectrumWarmupSteps:int32(p.SpectrumWarmupSteps), SpectrumStopPercent:p.SpectrumStopPercent}
}

func nativeHiresParams(p HiresParams) NativeHiresParams {
    return NativeHiresParams{Enabled:p.Enabled, Upscaler:int32(p.Upscaler), ModelPath:nativeCString(p.ModelPath), Scale:p.Scale,
        TargetWidth:int32(p.TargetWidth), TargetHeight:int32(p.TargetHeight), Steps:int32(p.Steps), DenoisingStrength:p.DenoisingStrength,
        UpscaleTileSize:int32(p.UpscaleTileSize), CustomSigmas:p.CustomSigmas, CustomSigmasCount:int32(p.CustomSigmasCount)}
}

// Populate a native generation structure in caller-owned storage. Keeping the
// large aggregate out of the Hike function return ABI makes this boundary
// independent of platform-specific aggregate-return conventions.
func nativeImageGenParamsInto(p *ImageGenParams, n *NativeImageGenParams) {
    if n == nil { return }
    sd_img_gen_params_init(n)
    if p == nil { return }
    var lora NativeLoRA
    if p.LoRAs != nil {
        lora.IsHighNoise = p.LoRAs.IsHighNoise; lora.Multiplier = p.LoRAs.Multiplier
        lora.Path = nativeCString(p.LoRAs.Path); n.LoRAs = &lora
    }
    n.LoRACount = p.LoRACount; n.Prompt = nativeCString(p.Prompt); n.NegativePrompt = nativeCString(p.NegativePrompt)
    n.ClipSkip = int32(p.ClipSkip); n.InitImage = p.InitImage; n.RefImages = p.RefImages; n.RefImagesCount = int32(p.RefImagesCount)
    n.RefImageArgs = nativeCString(p.RefImageArgs); n.MaskImage = p.MaskImage; n.Width = p.Width; n.Height = p.Height
    n.SampleParams = nativeSampleParams(p.SampleParams); n.Strength = p.Strength; n.Seed = p.Seed; n.BatchCount = int32(p.BatchCount)
    n.ControlImage = p.ControlImage; n.ControlStrength = p.ControlStrength; n.IPAdapterImage = p.IPAdapterImage
    n.IPAdapterStrength = p.IPAdapterStrength; n.QwenImageLayers = int32(p.QwenImageLayers); n.CircularX = p.CircularX; n.CircularY = p.CircularY
    n.VAETilingParams = NativeTilingParams{Enabled:p.VAETilingParams.Enabled, TemporalTiling:p.VAETilingParams.TemporalTiling,
        TileSizeW:int32(p.VAETilingParams.TileSizeW), TileSizeH:int32(p.VAETilingParams.TileSizeH), TargetOverlap:p.VAETilingParams.TargetOverlap,
        RelSizeW:p.VAETilingParams.RelSizeW, RelSizeH:p.VAETilingParams.RelSizeH, ExtraTilingArgs:nativeCString(p.VAETilingParams.ExtraTilingArgs)}
    n.CacheParams = nativeCacheParams(p.CacheParams); n.HiresParams = nativeHiresParams(p.HiresParams)
    n.ImagePreprocessParams.Rules = nativeCString(p.ImagePreprocessParams.Rules)
    n.PhotoMakerParams.IDImages = p.PhotoMakerParams.IDImages; n.PhotoMakerParams.IDImagesCount = int32(p.PhotoMakerParams.IDImagesCount)
    n.PhotoMakerParams.IDEmbedPath = nativeCString(p.PhotoMakerParams.IDEmbedPath); n.PhotoMakerParams.StyleStrength = p.PhotoMakerParams.StyleStrength
    n.PuLIDParams.IDEmbeddingPath = nativeCString(p.PuLIDParams.IDEmbeddingPath); n.PuLIDParams.IDWeight = p.PuLIDParams.IDWeight
}

// Context owns a native model instance.
type Context struct { handle *byte }

// Upscaler owns an ESRGAN upscaling context.
type Upscaler struct { handle *byte }

// Adetailer owns an ADetailer detector context.
type Adetailer struct { handle *byte }

// AdetailerParams configures optional prompt overrides for face/detail
// detection and inpainting.
type AdetailerParams struct {
    // Prompt is the positive inpainting prompt override.
    Prompt string
    // NegativePrompt is the negative inpainting prompt override.
    NegativePrompt string
    // ExtraAdArgs contains native ADetailer options.
    ExtraAdArgs string
}

// NewUpscaler loads an ESRGAN model. The model path may be empty only when
// the native backend supports a model-free configuration.
func NewUpscaler(esrganPath string, direct bool, nThreads int, tileSize int, backend string, paramsBackend string) *Upscaler {
    handle := new_upscaler_ctx(nativeCString(esrganPath), direct, nThreads, tileSize, nativeCString(backend), nativeCString(paramsBackend))
    if handle == nil { return nil }
    return &Upscaler{handle: handle}
}

func (u *Upscaler) Close() {
    if u != nil && u.handle != nil { free_upscaler_ctx(u.handle); u.handle = nil }
}

// Upscale returns native-owned images. Release them with FreeImages.
func (u *Upscaler) Upscale(input Image, factor uint32) (*Image, int, bool) {
    if u == nil || u.handle == nil || factor == 0 { return nil, 0, false }
    var images *Image; count := int32(0)
    ok := hike_upscale_image(u.handle, input.Data, int32(input.Width), int32(input.Height), int32(input.Channel), factor, &images, &count)
    if !ok { return nil, 0, false }
    return images, int(count), true
}

// UpscaleFile performs native ESRGAN upscaling entirely in the native layer.
// This avoids passing the 24-byte image aggregate through the Hike ABI.
func (u *Upscaler) UpscaleFile(inputPath string, factor uint32, outputPath string) bool {
    if u == nil || u.handle == nil || factor == 0 { return false }
    return hike_upscale_file(u.handle, nativeCString(inputPath), factor, nativeCString(outputPath))
}

func (u *Upscaler) Factor() int { if u == nil || u.handle == nil { return 0 }; return get_upscale_factor(u.handle) }
func UpscalerModelScale(modelPath string) int { return get_upscaler_model_scale(nativeCString(modelPath)) }

// LoadWebP decodes an RGB WebP file in the native image layer.
func LoadWebP(path string) (*Image, bool) {
    image := Image{}
    if !hike_load_webp(nativeCString(path), &image) { return nil, false }
    return &image, true
}

// FreeImage releases an image allocated by LoadWebP or ResizeBicubic.
func FreeImage(image *Image) {
    if image != nil { hike_free_image(image) }
}

// ResizeBicubic applies the native bicubic image filter.
func ResizeBicubic(input *Image, width uint32, height uint32) (*Image, bool) {
    if input == nil { return nil, false }
    output := Image{}
    if !hike_resize_bicubic(input, width, height, &output) { return nil, false }
    return &output, true
}

// ResizeBicubicFile applies bicubic resize in the native layer and writes WebP.
func ResizeBicubicFile(inputPath string, width uint32, height uint32, outputPath string) bool {
    return hike_resize_bicubic_file(nativeCString(inputPath), width, height, nativeCString(outputPath))
}


// NewAdetailer loads an ADetailer detector model.
func NewAdetailer(detectorPath string, nThreads int, backend string, paramsBackend string) *Adetailer {
    handle := new_adetailer_ctx(nativeCString(detectorPath), nThreads, nativeCString(backend), nativeCString(paramsBackend))
    if handle == nil { return nil }
    return &Adetailer{handle: handle}
}

func (a *Adetailer) Close() {
    if a != nil && a.handle != nil { free_adetailer_ctx(a.handle); a.handle = nil }
}

// DetailImage applies detection and inpainting using the supplied diffusion
// context. Returned images are native-owned and must be released with
// FreeImages.
func (a *Adetailer) DetailImage(diffusion *Context, input Image, params AdetailerParams, inpaint *ImageGenParams) (*Image, int, bool) {
    if a == nil || a.handle == nil || diffusion == nil || diffusion.handle == nil || inpaint == nil { return nil, 0, false }
    nativeParams := NativeAdetailerParams{Prompt:nativeCString(params.Prompt), NegativePrompt:nativeCString(params.NegativePrompt), ExtraAdArgs:nativeCString(params.ExtraAdArgs)}
    nativeInpaint := NativeImageGenParams{}
    nativeImageGenParamsInto(inpaint, &nativeInpaint)
    var images *Image; count := int32(0)
    ok := adetail_image(a.handle, diffusion.handle, input, &nativeParams, &nativeInpaint, &images, &count)
    if !ok { return nil, 0, false }
    return images, int(count), true
}

// DetailImageFile keeps WebP decoding, ADetailer processing, and encoding in
// the native layer so the 24-byte Image aggregate never crosses the Hike ABI.
func (a *Adetailer) DetailImageFile(diffusion *Context, inputPath string, params AdetailerParams, inpaint *ImageGenParams, outputPath string) bool {
    if a == nil || a.handle == nil || diffusion == nil || diffusion.handle == nil || inpaint == nil { return false }
    nativeParams := NativeAdetailerParams{Prompt:nativeCString(params.Prompt), NegativePrompt:nativeCString(params.NegativePrompt), ExtraAdArgs:nativeCString(params.ExtraAdArgs)}
    nativeInpaint := NativeImageGenParams{}
    nativeImageGenParamsInto(inpaint, &nativeInpaint)
    return hike_adetail_file(a.handle, diffusion.handle, nativeCString(inputPath), &nativeParams, &nativeInpaint, nativeCString(outputPath))
}

func NewContext(params *ContextParams) *Context {
    if params == nil { return nil }
    nativeParams := nativeContextParams(params)
    handle := new_sd_ctx(&nativeParams)
    if handle == nil { return nil }
    return &Context{handle: handle}
}

func (c *Context) Close() {
    if c != nil && c.handle != nil {
        free_sd_ctx(c.handle)
        c.handle = nil
    }
}

func (c *Context) SupportsImageGeneration() bool {
    return c != nil && c.handle != nil && sd_ctx_supports_image_generation(c.handle)
}

func (c *Context) SupportsVideoGeneration() bool {
    return c != nil && c.handle != nil && sd_ctx_supports_video_generation(c.handle)
}

// LoadControlNet hot-swaps a ControlNet on an idle context.
func (c *Context) LoadControlNet(path string) bool {
    if c == nil || c.handle == nil { return false }
    return sd_ctx_load_control_net(c.handle, nativeCString(path))
}

func (c *Context) UnloadControlNet() bool {
    if c == nil || c.handle == nil { return false }
    return sd_ctx_unload_control_net(c.handle)
}

func (c *Context) HasControlNet() bool {
    return c != nil && c.handle != nil && sd_ctx_has_control_net(c.handle)
}

func (c *Context) DefaultSampleMethod() int {
    if c == nil || c.handle == nil { return -1 }
    return sd_get_default_sample_method(c.handle)
}

func (c *Context) DefaultScheduler(sampleMethod int) int {
    if c == nil || c.handle == nil { return -1 }
    return sd_get_default_scheduler(c.handle, sampleMethod)
}

func (c *Context) ModelVersion() string {
    if c == nil || c.handle == nil { return "" }
    value := sd_get_model_version_name(c.handle)
    if value == nil { return "" }
    return string(value)
}

func (c *Context) Generate(params *ImageGenParams) (*Image, int, bool) {
    if c == nil || c.handle == nil || params == nil { return nil, 0, false }
    nativeParams := NativeImageGenParams{}
    nativeImageGenParamsInto(params, &nativeParams)
    var images *Image
    count := int32(0)
    ok := generate_image(c.handle, &nativeParams, &images, &count)
    if !ok { return nil, 0, false }
    return images, int(count), true
}

// GenerateVideoNative exposes the official video API while keeping its
// pointer-heavy ABI mirror explicit. Call InitVideoGenParams before filling
// the structure and FreeImages/FreeAudio for returned buffers.
func (c *Context) GenerateVideoNative(params *NativeVideoGenParams) (*Image, int, *NativeAudio, int, bool) {
    if c == nil || c.handle == nil || params == nil { return nil, 0, nil, 0, false }
    var frames *Image
    var frameCount int32
    var audio *NativeAudio
    var fps int32
    ok := generate_video(c.handle, params, &frames, &frameCount, &audio, &fps)
    if !ok { return nil, 0, nil, 0, false }
    return frames, int(frameCount), audio, int(fps), true
}

func (c *Context) Cancel() { if c != nil && c.handle != nil { sd_cancel_generation(c.handle, SD_CANCEL_ALL) } }

func FreeImages(images *Image, count int) {
    if images != nil && count > 0 { free_sd_images(images, int32(count)) }
}

func FreeAudio(audio *NativeAudio) {
    if audio != nil { free_sd_audio(audio) }
}

// SaveWebP encodes an RGB/RGBA image with the bundled libwebp.dll and writes
// it to path. Quality is in the 0..100 range; values outside that range are
// clamped by libwebp.
func SaveWebP(image *Image, path string, quality float32) bool {
    if image == nil || image.Data == nil || image.Width == 0 || image.Height == 0 { return false }
    if image.Channel != 3 && image.Channel != 4 { return false }
    var encoded *byte
    stride := int(image.Width * image.Channel)
    size := 0
    if image.Channel == 3 {
        size = WebPEncodeRGB(image.Data, int(image.Width), int(image.Height), stride, quality, &encoded)
    } else {
        size = WebPEncodeRGBA(image.Data, int(image.Width), int(image.Height), stride, quality, &encoded)
    }
    if size <= 0 || encoded == nil { return false }
    defer WebPFree(encoded)
    file := fopen(cstring(path), cstring("wb"))
    if file == nil { return false }
    written := fwrite(encoded, 1, size, file)
    fclose(file)
    return written == size
}

func InitContextParams(params *ContextParams) {
    if params == nil { return }
    n := NativeContextParams{}; sd_ctx_params_init(&n)
    params.NThreads = n.NThreads; params.WType = n.WType; params.RNGType = n.RNGType
    params.SamplerRNGType = n.SamplerRNGType; params.Prediction = n.Prediction; params.LoRAApplyMode = n.LoRAApplyMode
    params.EnableMMap = n.EnableMMap; params.FlashAttn = n.FlashAttn; params.DiffusionFlashAttn = n.DiffusionFlashAttn
    params.TAEPreviewOnly = n.TAEPreviewOnly; params.DiffusionConvDirect = n.DiffusionConvDirect
    params.VAEConvDirect = n.VAEConvDirect; params.ForceSDXLVAEConvScale = n.ForceSDXLVAEConvScale
    params.VAEFormat = n.VAEFormat; params.DisablePrefetch = n.DisablePrefetch; params.EagerLoad = n.EagerLoad
    params.AutoFit = n.AutoFit; params.DisableSegmentedCompute = n.DisableSegmentedCompute
    params.LinearScale = n.LinearScale; params.AttnScale = n.AttnScale; params.SageAttn = n.SageAttn
    params.ConditioningCacheSize = n.ConditioningCacheSize
}
func InitSampleParams(params *SampleParams) {
    if params == nil { return }; n := NativeSampleParams{}; sd_sample_params_init(&n)
