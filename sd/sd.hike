func Version() string { value := sd_version(); if value == nil { return "" }; return string(value) }
func Commit() string { value := sd_commit(); if value == nil { return "" }; return string(value) }
func SystemInfo() string { value := sd_get_system_info(); if value == nil { return "" }; return string(value) }
func PhysicalCoreCount() int { return int(sd_get_num_physical_cores()) }

// Progress is a polling-friendly view of the native generation callback.
type Progress struct { Step int; Steps int; Time float32 }

func SetProgressPolling(enabled bool) { hike_set_progress_polling(enabled) }
func FlushStderr() { hike_flush_stderr() }
func SelectAcceleratorBackend() string {
    value := hike_select_accelerator_backend()
    if value == nil { return "" }
    return string(value)
}
func CurrentProgress() Progress {
    return Progress{Step: hike_progress_step_value(), Steps: hike_progress_steps_value(), Time: hike_progress_time_value()}
}
func ResetProgress() { hike_reset_progress() }
func SetOperationActive(active bool) { hike_set_operation_active(active) }
func OperationActive() bool { return hike_operation_is_active() }

func SetLogPolling(enabled bool) { hike_set_log_polling(enabled) }
func LastLog() string {
    value := hike_last_log_value()
    if value == nil { return "" }
    return string(value)
}
func SetPreviewPolling(enabled bool, mode int, interval int, denoised bool, noisy bool) {
    hike_set_preview_polling(enabled, mode, interval, denoised, noisy)
}
func CopyPreview() (*Image, bool) {
    image := Image{}
    if !hike_copy_preview(&image) { return nil, false }
    return &image, true
}
func PreviewInfo() (int, int) {
    samplePass := 0; totalSteps := 0
    hike_get_preview_info(&samplePass, &totalSteps)
    return samplePass, totalSteps
}

func PreprocessCanny(image *Image, highThreshold float32, lowThreshold float32, weak float32, strong float32, inverse bool) bool {
    return image != nil && hike_preprocess_canny(image, highThreshold, lowThreshold, weak, strong, inverse)
}

func ContextParamsString(params *ContextParams) string {
    if params == nil { return "" }
    n := nativeContextParams(params)
    return string(hike_ctx_params_to_str(&n))
}

func SampleParamsString(params *SampleParams) string {
    if params == nil { return "" }
    n := nativeSampleParams(params)
    return string(hike_sample_params_to_str(&n))
}

func ImageGenParamsString(params *ImageGenParams) string {
    if params == nil { return "" }
    n := NativeImageGenParams{}
    sd_img_gen_params_init(&n)
    nativeImageGenParamsInto(params, &n)
    return string(hike_img_gen_params_to_str(&n))
}

func SDTypeFromString(value string) int { return str_to_sd_type(nativeCString(value)) }
func RNGTypeFromString(value string) int { return str_to_rng_type(nativeCString(value)) }
func SampleMethodFromString(value string) int { return str_to_sample_method(nativeCString(value)) }
func SchedulerFromString(value string) int { return str_to_scheduler(nativeCString(value)) }
func PredictionFromString(value string) int { return str_to_prediction(nativeCString(value)) }
func PreviewFromString(value string) int { return str_to_preview(nativeCString(value)) }
func LoRAApplyModeFromString(value string) int { return str_to_lora_apply_mode(nativeCString(value)) }
func HiresUpscalerFromString(value string) int { return str_to_sd_hires_upscaler(nativeCString(value)) }

func ConvertModel(inputPath string, vaePath string, outputPath string, outputType int, tensorTypeRules string, convertName bool) bool {
    return convert(nativeCString(inputPath), nativeCString(vaePath), nativeCString(outputPath), outputType, nativeCString(tensorTypeRules), convertName)
}

func ConvertModelWithComponents(modelPath string, clipLPath string, clipGPath string, t5xxlPath string, diffusionModelPath string, vaePath string, outputPath string, outputType int, tensorTypeRules string, convertName bool, nThreads int, loras *NativeLoRA, loraCount int) bool {
    return convert_with_components(nativeCString(modelPath), nativeCString(clipLPath), nativeCString(clipGPath), nativeCString(t5xxlPath), nativeCString(diffusionModelPath), nativeCString(vaePath), nativeCString(outputPath), outputType, nativeCString(tensorTypeRules), convertName, nThreads, loras, loraCount)
}

func LoadIMatrix(path string) bool { return load_imatrix(nativeCString(path)) }
func SaveIMatrix(path string) { save_imatrix(nativeCString(path)) }
func EnableIMatrixCollection() { enable_imatrix_collection() }
func DisableIMatrixCollection() { disable_imatrix_collection() }

