// Package sd is a small Hike binding for the stable-diffusion.cpp C API.
//
// The native library deliberately owns the model and generated image memory.
// Call Context.Close and FreeImages when the returned values are no longer
// needed. Pointers in this file are opaque C handles unless documented as an
// image or parameter structure.
package sd

// Stable-diffusion.cpp enums are represented as int in Hike. This keeps the
// declarations portable while preserving the C ABI used by the library.
const (
    // rng_type_t
    STD_DEFAULT_RNG int = 0
    CUDA_RNG int = 1
    CPU_RNG int = 2
    RNG_TYPE_COUNT int = 3

    // sample_method_t
    EULER_SAMPLE_METHOD int = 0
    EULER_A_SAMPLE_METHOD int = 1
    HEUN_SAMPLE_METHOD int = 2
    DPM2_SAMPLE_METHOD int = 3
    DPMPP2S_A_SAMPLE_METHOD int = 4
    DPMPP2M_SAMPLE_METHOD int = 5
    DPMPP2Mv2_SAMPLE_METHOD int = 6
    IPNDM_SAMPLE_METHOD int = 7
    IPNDM_V_SAMPLE_METHOD int = 8
    LCM_SAMPLE_METHOD int = 9
    DDIM_TRAILING_SAMPLE_METHOD int = 10
    TCD_SAMPLE_METHOD int = 11
    RES_MULTISTEP_SAMPLE_METHOD int = 12
    RES_2S_SAMPLE_METHOD int = 13
    ER_SDE_SAMPLE_METHOD int = 14
    EULER_CFG_PP_SAMPLE_METHOD int = 15
    EULER_A_CFG_PP_SAMPLE_METHOD int = 16
    EULER_GE_SAMPLE_METHOD int = 17
    DPMPP2M_SDE_SAMPLE_METHOD int = 18
    DPMPP2M_SDE_BT_SAMPLE_METHOD int = 19
    LMS_SAMPLE_METHOD int = 20
    SAMPLE_METHOD_COUNT int = 21

    // scheduler_t
    DISCRETE_SCHEDULER int = 0
    KARRAS_SCHEDULER int = 1
    EXPONENTIAL_SCHEDULER int = 2
    AYS_SCHEDULER int = 3
    GITS_SCHEDULER int = 4
    SGM_UNIFORM_SCHEDULER int = 5
    SIMPLE_SCHEDULER int = 6
    SMOOTHSTEP_SCHEDULER int = 7
    KL_OPTIMAL_SCHEDULER int = 8
    LCM_SCHEDULER int = 9
    BONG_TANGENT_SCHEDULER int = 10
    LTX2_SCHEDULER int = 11
    LOGIT_NORMAL_SCHEDULER int = 12
    FLUX2_SCHEDULER int = 13
    FLUX_SCHEDULER int = 14
    BETA_SCHEDULER int = 15
    LLADA_IMAGE_SCHEDULER int = 16
    SCHEDULER_COUNT int = 17

    // prediction_t
    EPS_PRED int = 0
    V_PRED int = 1
    EDM_V_PRED int = 2
    FLOW_PRED int = 3
    FLUX_FLOW_PRED int = 4
    SEFI_FLOW_PRED int = 5
    MINIT2I_FLOW_PRED int = 6
    SENSENOVA_U1_FLOW_PRED int = 7
    PREDICTION_COUNT int = 8

    // sd_type_t (same numeric values as ggml_type)
    SD_TYPE_F32 int = 0
    SD_TYPE_F16 int = 1
    SD_TYPE_Q4_0 int = 2
    SD_TYPE_Q4_1 int = 3
    SD_TYPE_Q5_0 int = 6
    SD_TYPE_Q5_1 int = 7
    SD_TYPE_Q8_0 int = 8
    SD_TYPE_Q8_1 int = 9
    SD_TYPE_Q2_K int = 10
    SD_TYPE_Q3_K int = 11
    SD_TYPE_Q4_K int = 12
    SD_TYPE_Q5_K int = 13
    SD_TYPE_Q6_K int = 14
    SD_TYPE_Q8_K int = 15
    SD_TYPE_IQ2_XXS int = 16
    SD_TYPE_IQ2_XS int = 17
    SD_TYPE_IQ3_XXS int = 18
    SD_TYPE_IQ1_S int = 19
    SD_TYPE_IQ4_NL int = 20
    SD_TYPE_IQ3_S int = 21
    SD_TYPE_IQ2_S int = 22
    SD_TYPE_IQ4_XS int = 23
    SD_TYPE_I8 int = 24
    SD_TYPE_I16 int = 25
    SD_TYPE_I32 int = 26
    SD_TYPE_I64 int = 27
    SD_TYPE_F64 int = 28
    SD_TYPE_IQ1_M int = 29
    SD_TYPE_BF16 int = 30
    SD_TYPE_TQ1_0 int = 34
    SD_TYPE_TQ2_0 int = 35
    SD_TYPE_MXFP4 int = 39
    SD_TYPE_NVFP4 int = 40
    SD_TYPE_Q1_0 int = 41
    SD_TYPE_Q2_0 int = 42
    SD_TYPE_F8_E4M3 int = 43
    SD_TYPE_F8_E5M2 int = 44
    SD_TYPE_COUNT int = 45

    // sd_log_level_t
    SD_LOG_DEBUG int = 0
    SD_LOG_VERBOSE int = 1
    SD_LOG_INFO int = 2
    SD_LOG_WARN int = 3
    SD_LOG_ERROR int = 4

    // preview_t
    PREVIEW_NONE int = 0
    PREVIEW_PROJ int = 1
    PREVIEW_TAE int = 2
    PREVIEW_VAE int = 3
    PREVIEW_COUNT int = 4

    // lora_apply_mode_t
    LORA_APPLY_AUTO int = 0
    LORA_APPLY_IMMEDIATELY int = 1
    LORA_APPLY_AT_RUNTIME int = 2
    LORA_APPLY_MODE_COUNT int = 3

    // sd_vae_format_t
    SD_VAE_FORMAT_AUTO int = -1
    SD_VAE_FORMAT_FLUX int = 0
    SD_VAE_FORMAT_SD3 int = 1
    SD_VAE_FORMAT_FLUX2 int = 2
    SD_VAE_FORMAT_WAN int = 3
    SD_VAE_FORMAT_COUNT int = 4

    // sd_cache_mode_t
    SD_CACHE_DISABLED int = 0
    SD_CACHE_EASYCACHE int = 1
    SD_CACHE_UCACHE int = 2
    SD_CACHE_DBCACHE int = 3
    SD_CACHE_TAYLORSEER int = 4
    SD_CACHE_CACHE_DIT int = 5
    SD_CACHE_SPECTRUM int = 6

    // sd_hires_upscaler_t
    SD_HIRES_UPSCALER_NONE int = 0
    SD_HIRES_UPSCALER_LATENT int = 1
    SD_HIRES_UPSCALER_LATENT_NEAREST int = 2
    SD_HIRES_UPSCALER_LATENT_NEAREST_EXACT int = 3
    SD_HIRES_UPSCALER_LATENT_ANTIALIASED int = 4
    SD_HIRES_UPSCALER_LATENT_BICUBIC int = 5
    SD_HIRES_UPSCALER_LATENT_BICUBIC_ANTIALIASED int = 6
    SD_HIRES_UPSCALER_LANCZOS int = 7
    SD_HIRES_UPSCALER_NEAREST int = 8
    SD_HIRES_UPSCALER_MODEL int = 9
    SD_HIRES_UPSCALER_COUNT int = 10

    // sd_cancel_mode_t
    SD_CANCEL_ALL int = 0
    SD_CANCEL_NEW_LATENTS int = 1
    SD_CANCEL_RESET int = 2

    // Friendly aliases used by the public Hike API.
    RNGDefault int = 0
    RNGCUDA int = 1
    RNGCPU int = 2

    SampleEuler int = 0
    SampleEulerA int = 1
    SampleHeun int = 2
    SampleDPM2 int = 3
    SampleDPMPlusPlus2M int = 5
    SampleLCM int = 9

    SchedulerDiscrete int = 0
    SchedulerKarras int = 1
    SchedulerExponential int = 2
    SchedulerSimple int = 6

    PreviewNone int = 0
    PreviewProj int = 1
    PreviewTAE int = 2
    PreviewVAE int = 3

    TypeF32 int = 0
    TypeF16 int = 1
    TypeQ4_0 int = 2
    TypeQ8_0 int = 8
    TypeQ4_K int = 12
    TypeQ5_K int = 13
    TypeQ6_K int = 14
)

// Image is the byte-addressable image returned by stable-diffusion.cpp.
// Data is owned by the native library until FreeImages is called.
type Image struct {
    Width uint32
    Height uint32
    Channel uint32
    Data *byte
}

type NativeEmbedding struct { Name cstring; Path cstring }

type NativeTilingParams struct {
    Enabled bool
    TemporalTiling bool
    TileSizeW int32
    TileSizeH int32
    TargetOverlap float32
    RelSizeW float32
    RelSizeH float32
    ExtraTilingArgs cstring
}

type NativeContextParams struct {
    ModelPath cstring
    ClipLPath cstring
    ClipGPath cstring
    ClipVisionPath cstring
    T5XXLPath cstring
    LLMPath cstring
    LLMVisionPath cstring
    DiffusionModelPath cstring
    HighNoiseDiffusionModelPath cstring
    UncondDiffusionModelPath cstring
    EmbeddingsConnectorsPath cstring
    VAEPath cstring
    AudioVAEPath cstring
    AudioEncoderPath cstring
    TAESDPath cstring
    ControlNetPath cstring
    IPAdapterPath cstring
    MotionModulePath cstring
    Embeddings *NativeEmbedding
    EmbeddingCount uint32
    PhotoMakerPath cstring
    PuLIDWeightsPath cstring
    TensorTypeRules cstring
    NThreads int32
    WType int32
    RNGType int32
    SamplerRNGType int32
    Prediction int32
    LoRAApplyMode int32
    EnableMMap bool
    FlashAttn bool
    DiffusionFlashAttn bool
    TAEPreviewOnly bool
    DiffusionConvDirect bool
    VAEConvDirect bool
    ForceSDXLVAEConvScale bool
    VAEFormat int32
    MaxVRAM cstring
    DisablePrefetch bool
    EagerLoad bool
    Backend cstring
    ParamsBackend cstring
    SplitMode cstring
    AutoFit bool
    RPCServers cstring
    ModelArgs cstring
    DisableSegmentedCompute bool
    LinearScale float32
    AttnScale float32
    Tokenizer cstring
    SageAttn bool
    ConditioningCacheSize int32
}

type NativeGuidanceParams struct {
    TxtCFG float32
    ImgCFG float32
    DistilledGuidance float32
    SLG NativeSLGParams
}

type NativeSLGParams struct {
    // The pointer width is the ABI-relevant part here; the native API reads
    // an array of C int values and the public Hike value is kept as-is.
    Layers *int
    LayerCount uint
    LayerStart float32
    LayerEnd float32
    Scale float32
}

type NativeSampleParams struct {
    Guidance NativeGuidanceParams
    Scheduler int32
    SampleMethod int32
    SampleSteps int32
    Eta float32
    ShiftedTimestep int32
    CustomSigmas *float32
    CustomSigmasCount int32
    FlowShift float32
    ExtraSampleArgs cstring
}

type NativeLoRA struct {
    IsHighNoise bool
    Multiplier float32
    Path cstring
}

type NativePhotoMakerParams struct {
    IDImages *Image
    IDImagesCount int32
    IDEmbedPath cstring
    StyleStrength float32
}

type NativePuLIDParams struct {
    IDEmbeddingPath cstring
    IDWeight float32
}

type NativeCacheParams struct {
    Mode int32
    ReuseThreshold float32
    StartPercent float32
    EndPercent float32
    ErrorDecayRate float32
    UseRelativeThreshold bool
    ResetErrorOnCompute bool
    FnComputeBlocks int32
    BnComputeBlocks int32
    ResidualDiffThreshold float32
    MaxWarmupSteps int32
    MaxCachedSteps int32
    MaxContinuousCachedSteps int32
    TaylorseerNDerivatives int32
    TaylorseerSkipInterval int32
    SCMMask cstring
    SCMPolicyDynamic bool
    SpectrumW float32
    SpectrumM int32
    SpectrumLam float32
    SpectrumWindowSize int32
    SpectrumFlexWindow float32
    SpectrumWarmupSteps int32
    SpectrumStopPercent float32
}

type NativeHiresParams struct {
    Enabled bool
    Upscaler int32
    ModelPath cstring
    Scale float32
    TargetWidth int32
    TargetHeight int32
    Steps int32
    DenoisingStrength float32
    UpscaleTileSize int32
    CustomSigmas *float32
    CustomSigmasCount int32
}

type NativeImagePreprocessParams struct { Rules cstring }

type NativeImageGenParams struct {
    LoRAs *NativeLoRA
    LoRACount uint32
    Prompt cstring
    NegativePrompt cstring
    ClipSkip int32
    InitImage Image
    RefImages *Image
    RefImagesCount int32
    RefImageArgs cstring
    MaskImage Image
    Width int32
    Height int32
    SampleParams NativeSampleParams
    Strength float32
    Seed int64
    BatchCount int32
    ControlImage Image
    ControlStrength float32
    IPAdapterImage Image
    IPAdapterStrength float32
    PhotoMakerParams NativePhotoMakerParams
    PuLIDParams NativePuLIDParams
    VAETilingParams NativeTilingParams
    CacheParams NativeCacheParams
    HiresParams NativeHiresParams
    QwenImageLayers int32
    CircularX bool
    CircularY bool
    ImagePreprocessParams NativeImagePreprocessParams
}

type NativeAudio struct {
    SampleRate uint32
    Channels uint32
    SampleCount uint64
    Data *float32
}

// NativeVideoGenParams mirrors sd_vid_gen_params_t. Image and audio arrays
// are intentionally represented as native pointers; higher-level video
// helpers can be added without passing large aggregates through Hike ABI.
type NativeVideoGenParams struct {
    LoRAs *NativeLoRA
    LoRACount uint32
    Prompt cstring
    NegativePrompt cstring
    ClipSkip int32
    InitImage Image
    EndImage Image
    RefImages *Image
    RefImagesCount int32
    RefVideos *byte
    RefVideosCount int32
    RefAudios *NativeAudio
    RefAudiosCount int32
    ControlFrames *Image
    ControlFramesSize int32
    Width int32
    Height int32
    SampleParams NativeSampleParams
    HighNoiseSampleParams NativeSampleParams
    MoeBoundary float32
    Strength float32
    Seed int64
    VideoFrames int32
    FPS int32
    VACEStrength float32
    VAETilingParams NativeTilingParams
    CacheParams NativeCacheParams
    HiresParams NativeHiresParams
    CircularX bool
    CircularY bool
    ImagePreprocessParams NativeImagePreprocessParams
}

type NativeAdetailerParams struct {
    Prompt cstring
    NegativePrompt cstring
    ExtraAdArgs cstring
}

// The public parameter types intentionally use Hike string values. The
// Native* types above are private ABI mirrors and are populated only while a
// native call is in progress.
type Embedding struct {
    // Name is the embedding token name exposed to the prompt tokenizer.
    Name string
    // Path is the embedding weights file path.
    Path string
}
type TilingParams struct {
    // Enabled enables tiled VAE encode/decode.
    Enabled bool
    // TemporalTiling enables temporal tiling for video-capable models.
    TemporalTiling bool
    // TileSizeW is the spatial tile width in pixels; zero uses the native default.
    TileSizeW int
    // TileSizeH is the spatial tile height in pixels; zero uses the native default.
    TileSizeH int
    // TargetOverlap is the fractional overlap between adjacent tiles.
    TargetOverlap float32
    // RelSizeW optionally sets tile width as a fraction or target tile count.
    RelSizeW float32
    // RelSizeH optionally sets tile height as a fraction or target tile count.
    RelSizeH float32
    // ExtraTilingArgs contains backend-specific tiling options.
    ExtraTilingArgs string
}
type ContextParams struct {
    // ModelPath is the main model weights file.
    ModelPath string
    // ClipLPath is the optional CLIP-L weights file.
    ClipLPath string
    // ClipGPath is the optional CLIP-G weights file.
    ClipGPath string
    // ClipVisionPath is the optional CLIP vision encoder weights file.
    ClipVisionPath string
    // T5XXLPath is the optional T5-XXL weights file.
    T5XXLPath string
    // LLMPath is the optional language model weights file.
    LLMPath string
    // LLMVisionPath is the optional multimodal language-model vision weights file.
    LLMVisionPath string
    // DiffusionModelPath overrides the diffusion model component in ModelPath.
    DiffusionModelPath string
    // HighNoiseDiffusionModelPath is the high-noise model for two-stage models.
    HighNoiseDiffusionModelPath string
    // UncondDiffusionModelPath is the optional unconditional diffusion model.
    UncondDiffusionModelPath string
    // EmbeddingsConnectorsPath is the optional embeddings connector weights file.
    EmbeddingsConnectorsPath string
    // VAEPath overrides the VAE weights file.
    VAEPath string
    // AudioVAEPath is the optional audio VAE weights file.
    AudioVAEPath string
    // AudioEncoderPath is the optional audio encoder weights file.
    AudioEncoderPath string
    // TAESDPath is the optional TAESD preview decoder weights file.
    TAESDPath string
    // ControlNetPath is the optional ControlNet weights file.
    ControlNetPath string
    // IPAdapterPath is the optional IP-Adapter weights file.
    IPAdapterPath string
    // MotionModulePath is the optional motion module weights file.
    MotionModulePath string
    // Embeddings points to the first embedding descriptor.
    Embeddings *Embedding
    // EmbeddingCount is the number of embedding descriptors.
    EmbeddingCount uint32
    // PhotoMakerPath is the optional PhotoMaker weights file.
    PhotoMakerPath string
    // PuLIDWeightsPath is the optional PuLID weights file.
    PuLIDWeightsPath string
    // TensorTypeRules selects quantization types using native rule syntax.
    TensorTypeRules string
    // NThreads is the CPU worker count; zero or a negative value uses native defaults.
    NThreads int
    // WType selects the model weight type, such as TypeF16 or TypeQ4_K.
    WType int
    // RNGType selects the random-number generator for sampling.
    RNGType int
    // SamplerRNGType selects the random-number generator used by the sampler.
    SamplerRNGType int
    // Prediction selects the model prediction convention.
    Prediction int
    // LoRAApplyMode controls when LoRA weights are applied.
    LoRAApplyMode int
    // EnableMMap enables memory-mapped model loading.
    EnableMMap bool
    // FlashAttn enables flash attention where supported.
    FlashAttn bool
    // DiffusionFlashAttn enables flash attention in the diffusion model.
    DiffusionFlashAttn bool
    // TAEPreviewOnly limits preview decoding to the TAESD path.
    TAEPreviewOnly bool
    // DiffusionConvDirect enables direct diffusion convolution where supported.
    DiffusionConvDirect bool
    // VAEConvDirect enables direct VAE convolution where supported.
    VAEConvDirect bool
    // ForceSDXLVAEConvScale forces the SDXL VAE convolution scale.
    ForceSDXLVAEConvScale bool
    // VAEFormat selects the VAE format; zero means native automatic selection.
    VAEFormat int
    // MaxVRAM sets an optional per-device VRAM budget, for example "8.0".
    MaxVRAM string
    // DisablePrefetch disables asynchronous weight prefetching.
    DisablePrefetch bool
    // EagerLoad loads all model parameters during context creation.
    EagerLoad bool
    // Backend selects the compute backend or backend assignment.
    Backend string
    // ParamsBackend selects the parameter-storage backend or assignment.
    ParamsBackend string
    // SplitMode selects layer/row weight distribution across devices.
    SplitMode string
    // AutoFit enables automatic model fitting to available device memory.
    AutoFit bool
    // RPCServers lists optional remote backend servers.
    RPCServers string
    // ModelArgs contains model-specific native options.
    ModelArgs string
    // DisableSegmentedCompute forces monolithic graph execution.
    DisableSegmentedCompute bool
    // LinearScale overrides the model's linear input scale; zero keeps the default.
    LinearScale float32
    // AttnScale overrides flash-attention K/V scaling; zero keeps the default.
    AttnScale float32
    // Tokenizer is the tokenizer JSON path or tokenizer assignment string.
    Tokenizer string
    // SageAttn enables Sage attention where supported.
    SageAttn bool
    // ConditioningCacheSize is the maximum cached conditioning-entry count.
    ConditioningCacheSize int
}
type GuidanceParams struct {
    // TxtCFG is the text classifier-free guidance scale.
    TxtCFG float32
    // ImgCFG is the image/reference guidance scale.
    ImgCFG float32
    // DistilledGuidance is the guidance value for distilled models.
    DistilledGuidance float32
    // SLG contains skip-layer guidance settings.
    SLG SLGParams
}
type SLGParams struct {
    // Layers points to the skip-layer indices.
    Layers *int
    // LayerCount is the number of entries in Layers.
    LayerCount uint
    // LayerStart is the normalized sampling start fraction.
    LayerStart float32
    // LayerEnd is the normalized sampling end fraction.
    LayerEnd float32
    // Scale is the skip-layer guidance scale.
    Scale float32
}
type SampleParams struct {
    // Guidance contains classifier-free and skip-layer guidance settings.
    Guidance GuidanceParams
    // Scheduler selects the noise schedule.
    Scheduler int
    // SampleMethod selects the denoising sampler.
    SampleMethod int
    // SampleSteps is the number of denoising steps.
    SampleSteps int
    // Eta controls stochasticity for samplers that support it.
    Eta float32
    // ShiftedTimestep applies a timestep shift for supported models.
    ShiftedTimestep int
    // CustomSigmas points to optional custom noise-sigma values.
    CustomSigmas *float32
    // CustomSigmasCount is the number of values in CustomSigmas.
    CustomSigmasCount int
    // FlowShift controls flow-matching timestep shifting.
    FlowShift float32
    // ExtraSampleArgs contains sampler-specific native options.
    ExtraSampleArgs string
}
type LoRA struct {
    // IsHighNoise marks this LoRA as belonging to the high-noise stage.
    IsHighNoise bool
    // Multiplier is the LoRA strength.
    Multiplier float32
    // Path is the LoRA weights file path.
    Path string
}
type PhotoMakerParams struct {
    // IDImages points to the identity reference images.
    IDImages *Image
    // IDImagesCount is the number of identity reference images.
    IDImagesCount int
    // IDEmbedPath is the optional PhotoMaker identity embedding path.
    IDEmbedPath string
    // StyleStrength controls the style contribution.
    StyleStrength float32
}
type PuLIDParams struct {
    // IDEmbeddingPath is the identity embedding file path.
    IDEmbeddingPath string
    // IDWeight controls identity preservation strength.
    IDWeight float32
}
type CacheParams struct {
    // Mode selects the diffusion cache algorithm.
    Mode int
    // ReuseThreshold is the cache reuse error threshold.
    ReuseThreshold float32
    // StartPercent is the normalized sampling point where caching begins.
    StartPercent float32
    // EndPercent is the normalized sampling point where caching ends.
    EndPercent float32
    // ErrorDecayRate controls cache-error decay between steps.
    ErrorDecayRate float32
    // UseRelativeThreshold interprets ReuseThreshold relative to the signal.
    UseRelativeThreshold bool
    // ResetErrorOnCompute resets accumulated cache error after computation.
    ResetErrorOnCompute bool
    // FnComputeBlocks is the number of forward blocks to compute.
    FnComputeBlocks int
    // BnComputeBlocks is the number of backward blocks to compute.
    BnComputeBlocks int
    // ResidualDiffThreshold is the residual-difference cutoff.
    ResidualDiffThreshold float32
    // MaxWarmupSteps disables caching during this initial step count.
    MaxWarmupSteps int
    // MaxCachedSteps limits the total cached steps.
    MaxCachedSteps int
    // MaxContinuousCachedSteps limits consecutive cache reuse.
    MaxContinuousCachedSteps int
    // TaylorseerNDerivatives is the Taylor-series derivative count.
    TaylorseerNDerivatives int
    // TaylorseerSkipInterval is the Taylorseer recomputation interval.
    TaylorseerSkipInterval int
    // SCMMask contains the optional step/channel mask.
    SCMMask string
    // SCMPolicyDynamic enables dynamic SCM policy selection.
    SCMPolicyDynamic bool
    // SpectrumW is the spectrum-cache weighting value.
    SpectrumW float32
    // SpectrumM is the spectrum-cache rank/segment count.
    SpectrumM int
    // SpectrumLam is the spectrum-cache regularization value.
    SpectrumLam float32
    // SpectrumWindowSize is the spectrum-cache window length.
    SpectrumWindowSize int
    // SpectrumFlexWindow controls adaptive spectrum windowing.
    SpectrumFlexWindow float32
    // SpectrumWarmupSteps is the spectrum-cache warmup count.
    SpectrumWarmupSteps int
    // SpectrumStopPercent is the normalized spectrum-cache stop point.
    SpectrumStopPercent float32
}
type HiresParams struct {
    // Enabled enables high-resolution refinement or upscaling.
    Enabled bool
    // Upscaler selects the high-resolution upscaler implementation.
    Upscaler int
    // ModelPath is the optional upscaler model path.
    ModelPath string
    // Scale is the requested upscaling factor.
    Scale float32
    // TargetWidth is the requested output width in pixels.
    TargetWidth int
    // TargetHeight is the requested output height in pixels.
    TargetHeight int
    // Steps is the number of high-resolution denoising steps.
    Steps int
    // DenoisingStrength controls high-resolution denoising.
    DenoisingStrength float32
    // UpscaleTileSize is the upscaler tile size in pixels.
    UpscaleTileSize int
    // CustomSigmas points to optional high-resolution sigma values.
    CustomSigmas *float32
    // CustomSigmasCount is the number of values in CustomSigmas.
    CustomSigmasCount int
}
type ImagePreprocessParams struct {
    // Rules contains semicolon-separated image preprocessing rules.
    Rules string
}
type ImageGenParams struct {
    // LoRAs points to the first LoRA descriptor.
    LoRAs *LoRA
    // LoRACount is the number of descriptors in LoRAs.
    LoRACount uint32
    // Prompt is the positive text prompt.
    Prompt string
    // NegativePrompt is the negative text prompt.
    NegativePrompt string
    // ClipSkip controls how many final CLIP layers are skipped.
    ClipSkip int
    // InitImage is the optional image-to-image input image.
    InitImage Image
    // RefImages points to optional reference images.
    RefImages *Image
    // RefImagesCount is the number of reference images.
    RefImagesCount int
    // RefImageArgs contains reference-image-specific native options.
    RefImageArgs string
    // MaskImage is the optional inpainting mask image.
    MaskImage Image
    // Width is the generated image width in pixels.
    Width int
    // Height is the generated image height in pixels.
    Height int
    // SampleParams controls sampler, scheduler, guidance, and steps.
    SampleParams SampleParams
    // Strength controls image-to-image denoising strength.
    Strength float32
    // Seed selects the random seed; negative values request a random seed.
    Seed int64
    // BatchCount is the number of images to generate.
    BatchCount int
    // ControlImage is the optional ControlNet input image.
    ControlImage Image
    // ControlStrength controls ControlNet influence.
    ControlStrength float32
    // IPAdapterImage is the optional IP-Adapter reference image.
    IPAdapterImage Image
    // IPAdapterStrength controls IP-Adapter influence.
    IPAdapterStrength float32
    // PhotoMakerParams contains optional PhotoMaker identity inputs.
    PhotoMakerParams PhotoMakerParams
    // PuLIDParams contains optional PuLID identity inputs.
    PuLIDParams PuLIDParams
    // VAETilingParams controls tiled VAE processing.
    VAETilingParams TilingParams
    // CacheParams controls optional diffusion-step caching.
    CacheParams CacheParams
    // HiresParams controls optional high-resolution refinement.
    HiresParams HiresParams
    // QwenImageLayers selects the number of Qwen Image layers.
    QwenImageLayers int
    // CircularX enables horizontal circular padding.
    CircularX bool
    // CircularY enables vertical circular padding.
    CircularY bool
    // ImagePreprocessParams controls input image preprocessing.
    ImagePreprocessParams ImagePreprocessParams
}

